# ── Slack ─────────────────────────────────────────────
# OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Basic Information → App-Level Tokens (connections:write 권한)
SLACK_APP_TOKEN=xapp-...

# ── 사람/채널 (Slack ID: 프로필 → ⋮ → 멤버 ID 복사 / 채널 정보 하단의 채널 ID) ──
# 관리자: CSV 내보내기, 다른 사람 계정 연결, 예약 강제 해제
ADMIN_IDS=U0123ABCD
# 휴가 승인자 (비우면 ADMIN_IDS 사용, 둘 다 비면 자동 승인)
LEAVE_APPROVER_IDS=U0123ABCD
# 출퇴근 알림 채널. 이 채널 멤버가 근태 관리 대상이에요.
ATTENDANCE_CHANNEL=C0123ATTND
# 서버 알림·일일 요약 채널
SERVER_CHANNEL=C0123SERVR

# ── 시간 설정 (HH:MM, 한국 시간) ─────────────────────
TZ_NAME=Asia/Seoul
CHECKIN_REMINDER=10:30
CHECKOUT_REMINDER=21:00
TODO_DIGEST=09:00
SERVER_SUMMARY=09:00
# 연구실 자체 휴무일 (공휴일은 자동 반영)
EXTRA_HOLIDAYS=

# ── 서버 모니터링 ─────────────────────────────────────
# 에이전트와 공유하는 비밀값. `openssl rand -hex 24` 로 만드세요.
METRICS_TOKEN=change-me
METRICS_HOST=0.0.0.0
METRICS_PORT=8787
DISK_ALERT_PCT=90
OFFLINE_MINUTES=5
# 메모리만 잡고 사용률이 IDLE_GPU_UTIL% 이하인 상태가 이 시간(분) 넘게 이어지면 알림
IDLE_GPU_MINUTES=60
IDLE_GPU_UTIL=5
IDLE_GPU_MIN_MEM_MB=1000
# '비어 있는 GPU' 기준
FREE_GPU_UTIL=10
FREE_GPU_MEM_MB=500
RETENTION_DAYS=60
# 주간 GPU 리포트 (지난주 월~일, 예약 vs 실제 사용량)
GPU_WEEKLY_DAY=mon
GPU_WEEKLY=09:30

# ── Google Sheet (선택: 주간 GPU 사용 내역 누적 기록) ──
# 스프레드시트 URL의 /d/<여기>/edit 부분
GSHEET_ID=
# 서비스 계정 JSON 키 경로 (Docker면 ./data/google-sa.json 에 두고 /data/google-sa.json)
GOOGLE_SERVICE_ACCOUNT_FILE=
# 출퇴근·휴가 기록 시트 (개인 정보라 GPU 시트와 별도). 매일 이 시각에 이번 달·지난달을 다시 씀
ATTENDANCE_GSHEET_ID=
ATTENDANCE_SHEET_SYNC=04:30

# ── Claude API (미팅 정리·논문 선별/요약) ──────────────
# https://platform.claude.com 에서 발급. 비워 두면 규칙 기반으로 동작해요.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# ── 미팅 ─────────────────────────────────────────────
# '채널에도 게시'를 고른 미팅 요약 + 금요일 연구실 전체 action items 현황
MEETING_CHANNEL=C0123MEETG
WEEKLY_REVIEW_DAY=fri
WEEKLY_REVIEW=16:00

# ── 논문 ─────────────────────────────────────────────
PAPER_CHANNEL=C0123PAPER
# daily | weekly | both | off
PAPER_SCHEDULE=both
PAPER_DAILY=08:30
PAPER_WEEKLY_DAY=fri
PAPER_WEEKLY=17:00
PAPER_TOP_N=5
# Claude가 매긴 관련도(0~10)가 이 값 미만이면 소개하지 않음
PAPER_MIN_SCORE=6
# 매일 다이제스트에서 볼 최근 일수 (주말 논문 포함하려면 3)
PAPER_WINDOW_DAYS=3

# ── 학회 마감 ────────────────────────────────────────
# 매주 월요일 앞으로 6주 안의 마감 요약을 올릴 채널 (비우면 안 올림)
DEADLINE_CHANNEL=
# 목표 학회 D-30·14·7·3·1·당일 DM 시각
DEADLINE_REMIND=09:00
DEADLINE_WEEKLY_DAY=mon
DEADLINE_WEEKLY=09:00
# 첫 실행 때만 읽는 학회 초기 목록 (비우면 app/conferences.yaml)
DEADLINE_SEED_FILE=

DB_PATH=labbot.db
